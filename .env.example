# Public values embedded in dist/config.json during pnpm build
PUBLIC_API_URL=http://localhost:8787
PUBLIC_NEON_AUTH_URL=

# Custom Neon Function settings
APP_ORIGINS=http://localhost:5173,http://localhost:4173
AI_MODEL=gpt-5-mini
PUBLIC_CHAT_ENABLED=true
PUBLIC_CHAT_IP_LIMIT=20
PUBLIC_CHAT_GLOBAL_LIMIT=500
UPLOAD_HOURLY_LIMIT=20
RATE_LIMIT_SALT=replace-with-a-long-random-value

# Neon-managed values are added by `neon env pull`.
# Never commit DATABASE_URL, AWS credentials, or gateway tokens.
