{
  "name": "radius-artifact-neon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsx scripts/write-runtime-config.ts",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.server.json",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "storage:cors": "tsx scripts/configure-storage-cors.ts",
    "neon:dev": "neon dev",
    "neon:deploy": "neon deploy --env .env.local"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1127.0",
    "@aws-sdk/s3-request-presigner": "3.1127.0",
    "@lucide/svelte": "^1.41.0",
    "@neon/ai-sdk-provider": "0.10.0",
    "@neon/env": "1.3.2",
    "@neon/functions": "0.10.0",
    "@neondatabase/neon-js": "0.7.0-beta",
    "ai": "7.0.93",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.7",
    "jose": "6.2.12",
    "pg": "8.23.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@neon/config": "1.4.2",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "dotenv": "17.4.2",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
