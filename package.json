{
  "name": "radius-artifact-neon",
  "private": true,
  "version": "0.1.0",
  "description": "A demo Radius artifact with a complete Neon backend.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thisistonydang/radius-artifact-neon.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.ts --outDir .svelte-ssr && tsx scripts/prerender.ts && tsx scripts/write-runtime-config.ts",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.server.json",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "neon:dev": "neon dev",
    "neon:deploy": "neon deploy --env .env.local"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1138.0",
    "@aws-sdk/s3-request-presigner": "3.1138.0",
    "@lucide/svelte": "1.47.0",
    "@neon/ai-sdk-provider": "0.10.0",
    "@neon/env": "1.4.3",
    "@neon/functions": "0.11.0",
    "@neondatabase/neon-js": "0.7.0-beta",
    "ai": "7.0.111",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.8",
    "jose": "6.2.12",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@neon/config": "1.7.2",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "dotenv": "18.0.3",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
